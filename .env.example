# Shared runtime configuration for Docker Compose and local development.
# Copy to .env and adjust as needed.

# Database (host machine vs compose network)
DATABASE_URL=postgresql+psycopg://odis:odis@localhost:5432/odis

# API / worker health
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=development
CACHE_TTL_SECONDS=300

# Messaging / cache (compose service hostnames)
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=

# Telemetry forecasting (ONNX Runtime)
FORECAST_ENABLED=true
# ONNX_MODEL_PATH=backend/app/infrastructure/inference/models/persistence_drift_v1.onnx
ONNX_MODEL_ID=persistence_drift_v1
FORECAST_CONTEXT_LENGTH=24
FORECAST_HORIZON_STEPS=12

# Compose port overrides
API_PORT=8000
FRONTEND_PORT=8080

# Grafana (internal to compose network; credentials for first login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
